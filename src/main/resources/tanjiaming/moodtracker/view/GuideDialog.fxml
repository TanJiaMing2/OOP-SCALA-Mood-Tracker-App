<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400" prefWidth="500" stylesheets="@DarkTheme.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tanjiaming.moodtracker.view.GuideDialogController">

    <children>
        <TextArea fx:id="txtGuide" editable="false" layoutX="15" layoutY="15" prefHeight="330" prefWidth="470" text="Mood Improvement Guide  &#10;&#10;1. If your mood is low (1–2):  &#10;• Take a short walk   &#10;• Get enough sleep    &#10;• Talk to someone you trust  &#10;&#10;2. If your mood is moderate (3):    &#10;• Listen to music    &#10;• Do light exercise   &#10;• Write down positive thoughts  &#10;&#10;3. If your mood is high (4–5):    &#10;• Maintain good habits    &#10;• Share positivity with others    &#10;• Set small goals for the day  &#10;&#10;Remember: Your mood changes every day, and that is normal. Taking small steps can make a big difference." wrapText="true" />

        <Button layoutX="215" layoutY="360" onAction="#handleClose" text="Close" />
    </children>
</AnchorPane>
